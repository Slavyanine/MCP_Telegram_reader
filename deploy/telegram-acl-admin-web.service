[Unit]
Description=Telegram ACL administration web panel
Requires=telegram-acl-admin-broker.service
After=telegram-acl-admin-broker.service

[Service]
Type=simple
User=telegram-acl-admin
Group=telegram-acl-admin
WorkingDirectory=/opt/telegram-acl-mcp
ExecStart=/opt/telegram-acl-mcp/.venv/bin/telegram-acl-admin-web
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONNOUSERSITE=1
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
MemoryMax=256M
TasksMax=32

[Install]
WantedBy=multi-user.target
